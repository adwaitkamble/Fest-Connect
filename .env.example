# ==============================================================================
# FestConnect Environment Configuration Template
# Copy this file to .env for local development. Never commit .env into git.
# ==============================================================================

# Server & Client Configuration
PORT=4000
PORT_WEB=80
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost
COOKIE_SECURE=false

# Database (MySQL 8)
# For local host runs use DB_HOST=localhost; for Docker Compose use DB_HOST=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=festconnect
DB_USER=fest_user
DB_PASSWORD=fest_password_local_only
MYSQL_ROOT_PASSWORD=festconnect_root_secret_change_me
RUN_SEEDS=true

# Optional In-Memory Cache (Redis 7)
# For local host runs use REDIS_HOST=localhost; for Docker Compose use REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=60

# Authentication & Cryptographic Secrets
# In production, specify cryptographically random strings >= 32 characters
JWT_SECRET=local_demo_jwt_secret_change_in_production_min32chars
JWT_EXPIRES_IN=1h

# Digital Pass Cryptographic Signature (HMAC-SHA256)
# Must be an explicit, secure random string >= 32 characters
PASS_HMAC_SECRET=local_demo_pass_hmac_secret_min32chars_secure

# Payments Configuration
# Options: mock | razorpay (mock is forbidden when NODE_ENV=production)
PAYMENT_PROVIDER=mock
# Optional: Set your Razorpay Test/Live API keys to enable the real gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Notification Configuration
# Options: console | gmail (console prints formatted preview to server logs)
EMAIL_PROVIDER=console
GMAIL_USER=
GMAIL_APP_PASSWORD=

