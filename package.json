{
  "name": "festconnect-root",
  "version": "0.1.0",
  "private": true,
  "description": "FestConnect — A Centralized Technical Fest & Event Registration System (OOMSD BCER27PC02)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@festconnect/api",
    "dev:web": "npm run dev --workspace=@festconnect/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@festconnect/api",
    "build:web": "npm run build --workspace=@festconnect/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:api": "npm run typecheck --workspace=@festconnect/api",
    "typecheck:web": "npm run typecheck --workspace=@festconnect/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=@festconnect/api",
    "test:web": "npm run test --workspace=@festconnect/web",
    "db:migrate": "npm run db:migrate --workspace=@festconnect/api",
    "db:seed": "npm run db:seed --workspace=@festconnect/api",
    "db:reset": "npm run db:reset --workspace=@festconnect/api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "oomsd",
    "festconnect",
    "monorepo"
  ],
  "author": "FestConnect Project Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
